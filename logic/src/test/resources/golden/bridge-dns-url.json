{
    "log": {
        "level": "warn",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "bridge-dns",
                "type": "https",
                "server": "dns.google",
                "path": "/dns-query",
                "detour": "proxy"
            }
        ],
        "final": "bridge-dns",
        "strategy": "prefer_ipv4",
        "independent_cache": true
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.19.0.1/30"
            ],
            "mtu": 1400,
            "auto_route": true,
            "strict_route": false,
            "stack": "gvisor",
            "sniff": true,
            "sniff_override_destination": true
        },
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "127.0.0.1",
            "listen_port": 10808,
            "sniff": true,
            "sniff_override_destination": true
        }
    ],
    "outbounds": [
        {
            "type": "socks",
            "tag": "proxy",
            "version": "5",
            "server": "127.0.0.1",
            "server_port": 18200,
            "network": "tcp"
        },
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "rules": [
            {
                "port": [
                    18200
                ],
                "outbound": "direct"
            },
            {
                "protocol": "dns",
                "outbound": "direct"
            }
        ],
        "final": "proxy",
        "auto_detect_interface": true
    }
}
