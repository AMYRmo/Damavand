<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Damavand Lite launcher foreground — deliberately DIFFERENT from the
         main Damavand icon (solid white multi-peak mountain on red).
         Lite: a single sharp peak drawn as a thin WHITE OUTLINE on the dark
         background, with only the summit cap filled in Damavand Red.
         Light / minimal = Lite. -->
    <!-- single peak outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2F3F5"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M20,80 L54,28 L88,80" />
    <!-- red summit cap -->
    <path
        android:fillColor="#E5322D"
        android:pathData="M54,28 L61,40 L47,40 Z" />
    <!-- baseline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2F3F5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M14,88 L94,88" />
</vector>
