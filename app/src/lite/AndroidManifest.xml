<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 3.1.0 (PattNG): per-app proxy lists the installed apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 3.2.0 (PattNG): QR scan import. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 3.2.0 (PattNG): boot auto-start. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LiteApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DamavandLite">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 3.2.0 (PattNG): app shortcuts. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 3.2.0 (PattNG): boot auto-start. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 3.2.0 (PattNG): home-screen widget. -->
        <receiver
            android:name=".LiteWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.amyrmo.damavand.lite.STATUS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lite_widget_info" />
        </receiver>

        <service
            android:name=".LiteVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- 3.2.6: quick settings tile (control-center button). -->
        <service
            android:name=".LiteTileService"
            android:exported="true"
            android:icon="@drawable/ic_lite"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 3.2.11 (PattNG): Tasker plugin + start/stop/switch shortcuts. -->        <activity
            android:name=".ui.shortcut.TaskerActivity"
            android:exported="false"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.shortcut.ScSwitchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.DamavandLite.Translucent" />
        <activity
            android:name=".ui.shortcut.ScStartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.DamavandLite.Translucent" />
        <activity
            android:name=".ui.shortcut.ScStopActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.DamavandLite.Translucent" />
        <receiver
            android:name=".ui.shortcut.TaskerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- 3.2.11 (PattNG UrlSchemeActivity): shared text + damavandlite:// links. -->
        <activity
            android:name=".ui.UrlSchemeActivity"
            android:exported="true"
            android:theme="@style/Theme.DamavandLite.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- 1.0.1.2 (#92): the app's own damavand:// scheme, next to damavandlite://. -->
                <data android:scheme="damavandlite" />
                <data android:scheme="damavand" />
                <data android:host="install-config" />
                <data android:host="install-sub" />
            </intent-filter>
            <!-- 1.0.1.2 (#92): .dmv files (Lock & Share) open in the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.dmv" />
            </intent-filter>
        </activity>
    </application>
</manifest>
